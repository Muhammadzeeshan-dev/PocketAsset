# POCKETASSET ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Supabase Authentication & PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Single-Owner Admin Authorization (Set your own owner email)
ADMIN_EMAIL=your-email@gmail.com

# Server-Side Email Delivery (Gmail SMTP for Admin OTP & Security Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-gmail-app-password
APP_URL=http://localhost:3000
